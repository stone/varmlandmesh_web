# Kopiera till .env och fyll i GITHUB_TOKEN.

# Fine-grained token: bara repot stone/varmlandmesh_web, "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=stone/varmlandmesh_web
GITHUB_BRANCH=data

# Hur ofta nodes.json publiceras.
PUBLISH_INTERVAL=15m

# Område som tas med: syd,norr,väst,öst.
BBOX=58.8,61.1,11.6,14.5

# Noder som inte hörts på så här länge tas bort.
MAX_AGE=2160h
